# systemd unit — /etc/systemd/system/salesforce-crm.service
# After editing: sudo systemctl daemon-reload && sudo systemctl restart salesforce-crm

[Unit]
Description=SalesForce CRM (Next.js)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/salesforce-crm
EnvironmentFile=/opt/salesforce-crm/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/salesforce-crm

[Install]
WantedBy=multi-user.target
