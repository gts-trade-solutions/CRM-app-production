# Environment contract. The MVP runs with no env vars (all data is
# client-side). Variables below activate from the milestones noted —
# copy to .env.local and fill in as each lands.

# --- M2: Backend core -------------------------------------------------
# MySQL 8 connection string (Prisma)
# DATABASE_URL="mysql://user:password@localhost:3306/salesforce"
# NextAuth
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""            # openssl rand -base64 32

# --- M0/M2: Observability --------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# --- Files (S3) & email (SES) ----------------------------------------
# Without these the app falls back gracefully: attachments keep inline
# previews (small images), email is logged-only.
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ATTACHMENTS_BUCKET=""
# S3_ATTACHMENTS_PREFIX="crm-attachments/"
# SES (separate credential pair; falls back to the AWS_* pair if unset)
# SES_ACCESS_KEY_ID=""
# SES_SECRET_ACCESS_KEY=""
# SES_REGION="ap-south-1"
# SES_FROM_ADDRESS="verified-sender@yourdomain.in"

# --- Growth track -----------------------------------------------------
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# WHATSAPP_BUSINESS_TOKEN=""
